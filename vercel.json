{
  "rewrites": [
    {
      "source": "/",
      "destination": "/WebRouter site option 1"
    },
    {
      "source": "/option-2",
      "destination": "/WebRouter site option 2"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    }
  ],
  "cleanUrls": true
}
